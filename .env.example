# Copy to .env and fill in to enable trading + portfolio.
# Market data works with no keys at all.

# "prod" or "demo" (demo = paper trading at demo-api.kalshi.co)
KALSHI_ENV=prod

# From kalshi.com -> Account -> API Keys
KALSHI_API_KEY_ID=
# Absolute path to the RSA private key file you downloaded when creating the key
KALSHI_PRIVATE_KEY_PATH=
